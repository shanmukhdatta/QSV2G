rule (modulo E) Setup:
   [ Fr( ~skA ), Fr( ~skB ), Fr( ~kCS ), Fr( ~sid ), Fr( ~ac ), Fr( ~nu ) ]
  --[ EVConsented( ~sid, ~ac, ~nu ) ]->
   [
   !SignA( ~skA ), !SignB( ~skB ), !CSKey( ~kCS ), !PubA( pk(~skA) ),
   !PubB( pk(~skB) ), !Session( ~sid, ~ac, ~nu ),
   PendingEV( ~sid, ~ac, ~nu ), Out( pk(~skA) ), Out( pk(~skB) ),
   Out( <~sid, ~ac, ~nu> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Assumed_Honest_QSS_Reconstruction:
   [ !Session( sid, ac, nu ), Fr( ~reconstruction_hash ) ]
  --[ Reconstructed( sid, ac, nu, ~reconstruction_hash ) ]->
   [ !GatePassed( sid, ac, nu, ~reconstruction_hash ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Honest_UC_A_Sign:
   [ !GatePassed( sid, ac, nu, h ), !SignA( sk ) ]
  --[ SignedA( sid, ac, nu, h ) ]->
   [ Out( sign(<sid, ac, nu, h, 'A'>, sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Honest_UC_B_Sign:
   [ !GatePassed( sid, ac, nu, h ), !SignB( sk ) ]
  --[ SignedB( sid, ac, nu, h ) ]->
   [ Out( sign(<sid, ac, nu, h, 'B'>, sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Honest_CS_Auth_Response:
   [ !GatePassed( sid, ac, nu, h ), !CSKey( kCS ) ]
  --[ HonestResponse( sid, ac, nu, h ) ]->
   [ Out( mac(<sid, ac, nu, h>, kCS) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_UC_A:
   [ !SignA( sk ) ] --[ RevealA( ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_UC_B:
   [ !SignB( sk ) ] --[ RevealB( ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_CS:
   [ !CSKey( kCS ) ] --[ RevealCS( ) ]-> [ Out( kCS ) ]

  /* has exactly the trivial AC variant */

