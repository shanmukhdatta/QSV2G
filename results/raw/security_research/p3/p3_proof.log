lemma honest_accept_reachable:
  exists-trace "∃ sid ac nu h #i. EVAccepted( sid, ac, nu, h ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ sid ac nu h #i. (EVAccepted( sid, ac, nu, h ) @ #i)"
*/
simplify
solve( PendingEV( sid, ac, nu ) ▶₀ #i )
  case Setup
  solve( !PubA( pk(x) ) ▶₁ #i )
    case Setup
    solve( !PubB( pk(x) ) ▶₂ #i )
      case Setup
      solve( !CSKey( kCS ) ▶₃ #i )
        case Setup
        solve( !KU( sign(<~sid, ~ac, ~nu, h, 'A'>, ~skA) ) @ #vk.3 )
          case c_sign
          solve( !KU( ~skA ) @ #vk.9 )
            case Reveal_UC_A
            solve( !KU( sign(<~sid, ~ac, ~nu, h, 'B'>, ~skB) ) @ #vk.8 )
              case c_sign
              solve( !KU( ~skB ) @ #vk.20 )
                case Reveal_UC_B
                solve( !KU( mac(<~sid, ~ac, ~nu, h>, ~kCS) ) @ #vk.14 )
                  case c_mac
                  solve( !KU( ~kCS ) @ #vk.25 )
                    case Reveal_CS
                    solve( !KU( ~sid ) @ #vk.20 )
                      case Setup
                      solve( !KU( ~ac ) @ #vk.22 )
                        case Setup
                        solve( !KU( ~nu ) @ #vk.23 )
                          case Setup
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma single_use_per_session:
  all-traces
  "∀ sid ac nu h1 h2 #i #j.
    ((EVAccepted( sid, ac, nu, h1 ) @ #i) ∧
     (EVAccepted( sid, ac, nu, h2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ sid ac nu h1 h2 #i #j.
  (EVAccepted( sid, ac, nu, h1 ) @ #i) ∧
  (EVAccepted( sid, ac, nu, h2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( PendingEV( sid, ac, nu ) ▶₀ #i )
    case Setup
    solve( !PubA( pk(x) ) ▶₁ #i )
      case Setup
      solve( !PubB( pk(x) ) ▶₂ #i )
        case Setup
        solve( !CSKey( kCS ) ▶₃ #i )
          case Setup
          solve( PendingEV( ~sid, ~ac, ~nu ) ▶₀ #j )
            case Setup
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( PendingEV( sid, ac, nu ) ▶₀ #i )
    case Setup
    solve( !PubA( pk(x) ) ▶₁ #i )
      case Setup
      solve( !PubB( pk(x) ) ▶₂ #i )
        case Setup
        solve( !CSKey( kCS ) ▶₃ #i )
          case Setup
          solve( PendingEV( ~sid, ~ac, ~nu ) ▶₀ #j )
            case Setup
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
qed

lemma bypass_possible_with_full_compromise:
  exists-trace
  "∃ sid ac nu h #i #a #b #c.
    (((((((EVAccepted( sid, ac, nu, h ) @ #i) ∧ (RevealA( ) @ #a)) ∧
         (RevealB( ) @ #b)) ∧
        (RevealCS( ) @ #c)) ∧
       (#a < #i)) ∧
      (#b < #i)) ∧
     (#c < #i)) ∧
    (¬(∃ h2 #r. Reconstructed( sid, ac, nu, h2 ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ sid ac nu h #i #a #b #c.
  (EVAccepted( sid, ac, nu, h ) @ #i) ∧
  (RevealA( ) @ #a) ∧
  (RevealB( ) @ #b) ∧
  (RevealCS( ) @ #c)
 ∧
  (#a < #i) ∧
  (#b < #i) ∧
  (#c < #i) ∧
  (∀ h2 #r. (Reconstructed( sid, ac, nu, h2 ) @ #r) ⇒ ⊥)"
*/
simplify
solve( PendingEV( sid, ac, nu ) ▶₀ #i )
  case Setup
  solve( !PubA( pk(x) ) ▶₁ #i )
    case Setup
    solve( !PubB( pk(x) ) ▶₂ #i )
      case Setup
      solve( !CSKey( kCS.1 ) ▶₃ #i )
        case Setup
        solve( !SignA( sk ) ▶₀ #a )
          case Setup
          solve( !SignB( sk ) ▶₀ #b )
            case Setup
            solve( !CSKey( kCS ) ▶₀ #c )
              case Setup
              solve( !KU( sign(<~sid, ~ac, ~nu, h, 'A'>, ~skA.1) ) @ #vk.3 )
                case c_sign
                solve( !KU( ~skA.1 ) @ #vk.9 )
                  case Reveal_UC_A
                  solve( !KU( sign(<~sid, ~ac, ~nu, h, 'B'>, ~skB.1) ) @ #vk.8 )
                    case c_sign
                    solve( !KU( ~skB.1 ) @ #vk.20 )
                      case Reveal_UC_B
                      solve( !KU( mac(<~sid, ~ac, ~nu, h>, ~kCS.1) ) @ #vk.14 )
                        case c_mac
                        solve( !KU( ~kCS.1 ) @ #vk.25 )
                          case Reveal_CS
                          solve( !KU( ~sid ) @ #vk.20 )
                            case Setup
                            solve( !KU( ~ac ) @ #vk.22 )
                              case Setup
                              solve( !KU( ~nu ) @ #vk.23 )
                                case Setup
                                SOLVED // trace found
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

